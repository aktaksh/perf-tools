#!/usr/bin/env python3
#
# tcpretrans - show TCP retransmits, with address and other details.
#              Written using Linux ftrace.
#
# This is a Python port of the original Perl implementation. It intentionally
# preserves its x86_64 kprobe ABI, one-second snapshots, IPv4-only lookup,
# output format, and command-line API.
#
# From perf-tools: https://github.com/brendangregg/perf-tools
# COPYRIGHT: Copyright (c) 2014 Brendan Gregg.
# Licensed under the GNU General Public License, version 2 or later.

import getopt
import os
import re
import signal
import sys
import time


TRACING = "/sys/kernel/debug/tracing"
FLOCK = "/var/tmp/.ftrace-lock"
INTERVAL = 1
KNAME_RTR = "tcpretrans_tcp_retransmit_skb"
KNAME_TLP = "tcpretrans_tcp_send_loss_probe"
TCP_STATES = ("NULL", "ESTABLISHED", "SYN_SENT", "SYN_RECV", "FIN_WAIT1",
              "FIN_WAIT2", "TIME_WAIT", "CLOSE", "CLOSE_WAIT", "LAST_ACK",
              "LISTEN", "CLOSING")
stacks = False
tlp = False
cleaning_up = False


def usage():
    print("USAGE: tcpretrans [-hls]", file=sys.stderr)
    print("                  -h      # help message", file=sys.stderr)
    print("                  -l      # trace TCP tail loss probes", file=sys.stderr)
    print("                  -s      # print stack traces", file=sys.stderr)
    print("   eg,", file=sys.stderr)
    print("       tcpretrans         # trace TCP retransmits", file=sys.stderr)
    raise SystemExit(0)


def writeto(string, path, append=False):
    try:
        with open(path, "a" if append else "w") as file:
            file.write(string)
        return True
    except OSError:
        return False


def die(message, remove_lock=False):
    if remove_lock:
        try:
            os.unlink(FLOCK)
        except OSError:
            pass
    print(message, file=sys.stderr)
    raise SystemExit(1)


def create_kprobe(name, value):
    return writeto(f"p:{name} {value}", "kprobe_events", append=True)


def enable_kprobe(name):
    return writeto("1", f"events/kprobes/{name}/enable")


def remove_kprobe(name):
    return (writeto("0", f"events/kprobes/{name}/enable") and
            writeto(f"-:{name}", "kprobe_events", append=True))


def inet_h2a(address):
    return ".".join(str(int(address[index:index + 2], 16))
                    for index in (6, 4, 2, 0))


def cache_tcp():
    sockets = {}
    try:
        with open("/proc/net/tcp") as tcp_file:
            for line in tcp_file:
                if re.match(r"^ *sl", line):
                    continue
                fields = line.split()
                if len(fields) < 12:
                    continue
                socket_pointer = fields[11]
                if socket_pointer.startswith("0x"):
                    socket_pointer = socket_pointer[2:]
                sockets[socket_pointer] = {
                    "laddr": fields[1], "raddr": fields[2], "state": fields[3]
                }
    except OSError:
        die("ERROR: reading /proc/net/tcp.", remove_lock=True)
    return sockets


def cleanup(*_args, quiet=False):
    global cleaning_up
    if cleaning_up:
        raise SystemExit(0)
    cleaning_up = True
    if not quiet:
        print("\nEnding tracing...")
    if stacks and not writeto("0", "options/stacktrace"):
        if not quiet:
            print("WARNING: unable to disable stacktraces.", file=sys.stderr)
    if not remove_kprobe(KNAME_RTR):
        if not quiet:
            print(f"ERROR: removing kprobe {KNAME_RTR}", file=sys.stderr)
    if tlp and not remove_kprobe(KNAME_TLP):
        if not quiet:
            print(f"ERROR: removing kprobe {KNAME_TLP}", file=sys.stderr)
    writeto("", "trace")
    try:
        os.unlink(FLOCK)
    except OSError:
        pass
    raise SystemExit(0)


def end_with_error(message):
    print(message, file=sys.stderr)
    # Perl's edie() closed stdout and stderr before cleanup, making cleanup
    # silent while still removing probes and returning its historical status.
    cleanup(quiet=True)


def main(argv):
    global stacks, tlp
    try:
        options, _arguments = getopt.getopt(argv, "hsl", ["help", "stacks", "tlp"])
    except getopt.GetoptError:
        usage()
    for option, _value in options:
        if option in ("-h", "--help"):
            usage()
        if option in ("-s", "--stacks"):
            stacks = True
        if option in ("-l", "--tlp"):
            tlp = True

    for signum in (signal.SIGINT, signal.SIGQUIT, signal.SIGTERM,
                   signal.SIGPIPE, signal.SIGHUP):
        signal.signal(signum, cleanup)
    try:
        os.chdir(TRACING)
    except OSError:
        die("ERROR: accessing tracing. Root? Kernel has FTRACE?\n"
            "debugfs mounted? (mount -t debugfs debugfs /sys/kernel/debug)")

    if os.path.exists(FLOCK):
        try:
            with open(FLOCK) as lock_file:
                fpid = lock_file.readline().rstrip("\n")
        except OSError:
            fpid = ""
        die(f"ERROR: ftrace may be in use by PID {fpid} ({FLOCK})")
    if not writeto(str(os.getpid()), FLOCK):
        die(f"ERROR: unable to write {FLOCK}.")
    if not writeto("nop", "current_tracer"):
        die("ERROR: disabling current_tracer.", remove_lock=True)
    if not create_kprobe(KNAME_RTR, "tcp_retransmit_skb sk=%di"):
        die("ERROR: creating kprobe for tcp_retransmit_skb().", remove_lock=True)
    if tlp and not create_kprobe(KNAME_TLP, "tcp_send_loss_probe sk=%di"):
        end_with_error("ERROR: creating kprobe for tcp_send_loss_probe(). Older kernel version?")
    if stacks and not writeto("1", "options/stacktrace"):
        print("WARNING: unable to enable stacktraces.", file=sys.stderr)
    if not enable_kprobe(KNAME_RTR):
        end_with_error(f"ERROR: enabling {KNAME_RTR} probe.")
    if tlp and not enable_kprobe(KNAME_TLP):
        end_with_error(f"ERROR: enabling {KNAME_TLP} probe.")

    print(f"{'TIME':<8} {'PID':<6} {'LADDR:LPORT':<20} -- "
          f"{'RADDR:RPORT':<20} {'STATE':<12}", flush=True)
    while True:
        time.sleep(INTERVAL)
        try:
            with open("trace", errors="replace") as trace_file:
                trace = [line for line in trace_file if not line.startswith("#")]
        except OSError:
            end_with_error("ERROR: opening trace_pipe.")
        if not writeto("0", "trace"):
            end_with_error("ERROR: clearing trace")
        sockets = cache_tcp() if trace else {}

        for line in trace:
            if stacks and re.match(r"^ *=>", line):
                print(line, end="", flush=True)
                continue
            parts = line.split(None, 1)
            if len(parts) != 2:
                continue
            task_match = re.match(r"(.*)-(\d+)$", parts[0])
            socket_match = re.search(r"sk=([0-9a-fx]*)", parts[1])
            if not task_match or not socket_match or not socket_match.group(1):
                continue
            pid = task_match.group(2)
            socket_pointer = socket_match.group(1)
            if socket_pointer.startswith("0x"):
                socket_pointer = socket_pointer[2:]
            socket = sockets.get(socket_pointer)
            if socket:
                local_address, local_port = socket["laddr"].split(":")
                remote_address, remote_port = socket["raddr"].split(":")
                laddr, raddr = inet_h2a(local_address), inet_h2a(remote_address)
                lport, rport = int(local_port, 16), int(remote_port, 16)
                state_number = int(socket["state"], 16)
                state = TCP_STATES[state_number] if state_number < len(TCP_STATES) else ""
            else:
                laddr = raddr = lport = rport = state = "-"
            packet_type = "L" if KNAME_TLP in parts[1] else "R"
            print(f"{time.strftime('%H:%M:%S'):<8} {pid:<6} "
                  f"{f'{laddr}:{lport}':<20} {packet_type}> "
                  f"{f'{raddr}:{rport}':<20} {state:<12}", flush=True)


if __name__ == "__main__":
    main(sys.argv[1:])
