#!/usr/bin/env python3
#
# execsnoop - trace process exec() with arguments. /proc version.
#             Written using Linux ftrace.
#
# This is a Python port of the original Perl implementation. It intentionally
# preserves the ftrace setup, /proc races, output format, and command-line API.
#
# From perf-tools: https://github.com/brendangregg/perf-tools
# COPYRIGHT: Copyright (c) 2014 Brendan Gregg.
# Licensed under the GNU General Public License, version 2 or later.

import getopt
import os
import signal
import sys
import time


TRACING = "/sys/kernel/debug/tracing"
FLOCK = "/var/tmp/.ftrace-lock"
TPDIR = "sched/sched_process_exec"
TPTEXT = TPDIR.replace("/", ":")
trace_pipe = None
cleaning_up = False


def usage():
    print("USAGE: execsnoop [-h] [-n name]", file=sys.stderr)
    print("   eg,", file=sys.stderr)
    print('       execsnoop -n ls\t# show "ls" cmds only.', file=sys.stderr)
    raise SystemExit(0)


def writeto(string, path):
    try:
        with open(path, "w") as file:
            file.write(string)
        return True
    except OSError:
        return False


def die(message, remove_lock=False):
    if remove_lock:
        try:
            os.unlink(FLOCK)
        except OSError:
            pass
    print(message, file=sys.stderr)
    raise SystemExit(1)


def cleanup(*_args):
    global cleaning_up
    if cleaning_up:
        raise SystemExit(0)
    cleaning_up = True
    print("\nEnding tracing...")
    if trace_pipe is not None:
        trace_pipe.close()
    if not writeto("0", f"events/{TPDIR}/enable"):
        die(f'ERROR: disabling "{TPTEXT}"', remove_lock=True)
    writeto("", "trace")
    try:
        os.unlink(FLOCK)
    except OSError:
        pass
    raise SystemExit(0)


def main(argv):
    global trace_pipe
    name = None
    try:
        options, _arguments = getopt.getopt(argv, "hn:", ["help", "name="])
    except getopt.GetoptError:
        usage()
    for option, value in options:
        if option in ("-h", "--help"):
            usage()
        if option in ("-n", "--name"):
            name = value

    for signum in (signal.SIGINT, signal.SIGQUIT, signal.SIGTERM,
                   signal.SIGPIPE, signal.SIGHUP):
        signal.signal(signum, cleanup)

    try:
        os.chdir(TRACING)
    except OSError:
        die("ERROR: accessing tracing. Root? Kernel has FTRACE?\n"
            "debugfs mounted? (mount -t debugfs debugfs /sys/kernel/debug)",
            remove_lock=True)

    if os.path.exists(FLOCK):
        try:
            with open(FLOCK) as file:
                fpid = file.readline().rstrip("\n")
        except OSError:
            fpid = ""
        die(f"ERROR: ftrace may be in use by PID {fpid} ({FLOCK})")
    if not writeto(str(os.getpid()), FLOCK):
        die(f"ERROR: unable to write {FLOCK}.")

    if not writeto("nop", "current_tracer"):
        die("ERROR: disabling current_tracer.", remove_lock=True)
    if not writeto("1", f"events/{TPDIR}/enable"):
        die(f'ERROR: enabling tracepoint "{TPTEXT}" '
            "(tracepoint missing in this kernel version?)", remove_lock=True)
    try:
        trace_pipe = open("trace_pipe", errors="replace")
    except OSError as error:
        print(f"ERROR: opening trace_pipe: {error}", file=sys.stderr)
        cleanup()

    print(f"{'TIME':<8} {'PID':>6} {'PPID':>6} ARGS", flush=True)
    for line in trace_pipe:
        fields = line.split()
        if not fields:
            continue
        match = __import__("re").match(r"(.*)-(\d+)$", fields[0])
        if not match:
            continue
        task, pid = match.groups()
        if name is not None and name != task:
            continue

        args = f"{task} <?>"
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as cmdline:
                arglist = cmdline.readline()
            if arglist:
                args = arglist.replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            pass

        ppid = "?"
        try:
            with open(f"/proc/{pid}/stat") as stat:
                stat_fields = stat.readline().split()
            if len(stat_fields) > 3:
                ppid = stat_fields[3]
        except OSError:
            pass
        print(f"{time.strftime('%H:%M:%S'):<8} {pid:>6} {ppid:>6} {args}",
              flush=True)
    cleanup()


if __name__ == "__main__":
    main(sys.argv[1:])
